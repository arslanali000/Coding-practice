<style>
    .main-container-testimonial-section {
      display: flex;
      width: 100%;
      {% comment %} justify-content: center; {% endcomment %}
      align-items: center;
      height: 100vh; 
      background-color: #f5f5f5; 
      overflow-x: auto;

      
    }
    .display1 {
      display: flex;
      justify-content: center;
    
    }
    .display2 {
      display:flex;
      justify-content: start;
    
    }


    .card-testimonial-section {
      margin-left: 10px;
      margin-right: 10px;
      flex-grow: 0;
      flex-shrink: 0;
      flex-basis: auto;
      background-color: #cfcdcd; 
      width: 320px;
      height: 400px;
      border-radius: 10px; 
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); 
      text-align: center; 
    }
    .top-bar {
      width: 100%;
      height: 25%;
      background-color:rgb(22, 22, 26); 
      border-radius: 10px 10px 0 0; 
      clip-path: polygon(0 1%, 100% 0, 100% 80%, 0% 100%);

    }
    .content-bar {
      width: 100%;
      height: 50%;
      margin-bottom: 20px;
    
      
    }
    .bottom-bar {
      width: 100%;
      height: 25%;
      background-color: rgb(22, 22, 26); 
      border-radius: 0px 0px 10px 10px; 
      clip-path: polygon(0% 20%, 100% 0, 100% 100%, 0% 100%);

    }
    .content-sec {
      width: 100%;
      position: relative;
      
    }
    .content-sec img {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      margin-top: -60px; 
      border: 4px solid white; 
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
     
    }
    .content-sec h2{
     margin: 0;
    }
    @media screen and (max-width: 768px) {
      .main-container-testimonial-section {
        flex-direction: column;
        height: auto; 
        padding: 100px 20px; 
      }
      .card-testimonial-section {
        width: 90%; 
        height: auto; 
      }
      
      .content-sec img {
        width: 80px;
        height: 80px;
        margin-top: 10px; 
      }

      
    }
  </style>

  <div class="main-container-testimonial-section {% if section.blocks.size <= 4 %}display1{% else %}display2{% endif %}">
   {%  for block in section.blocks %}
      {%- liquid
        assign customer_image = block.settings.customer_image
        assign customer_name = block.settings.customer_name
        assign customer_review = block.settings.customer_review

      -%}
      <div class="card-testimonial-section ">  
        <div class="top-bar">

        </div>
        <div class="content-bar">
          <div class="content-sec">
            <img src="{{ customer_image | img_url: 'master' }}" alt=" profile image">
            <h2>{{customer_name}}</h2>
            <p style="padding: 10px 10px; margin-top: 10px; font-size: 14px; line-height: 1.4;">{{ customer_review }}</p>
          </div>

        </div>
        <div class="bottom-bar">
          <img src="https://cdn.shopify.com/s/files/1/0783/9377/0228/files/rating-50.png?v=1770784003" alt="5 stars" style="width: 100px; margin-top: 50px;">
        </div>

      </div>
   {% endfor %}
  </div>



  {% schema %}
  {
   "name": "Testimonials",
   "settings": [],
   "blocks": [
    {
     "type": "testimonial",
     "name": "Testimonial",
     "settings": [
      {
        "type": "image_picker",
         "id": "customer_image",
         "label": "Customer Photo"
      },
      {
       "type": "text",
       "id": "customer_name",
       "label": "Customer Name",
       "default": "Emily"

      },
      {
        "type": "inline_richtext",
        "id": "customer_review",
        "label": "Review Text",
        "default": "I recently purchased a pair of sunglasses from this store and I am absolutely thrilled with my purchase! The quality is outstanding, the design is stylish, and they fit perfectly. I've received so many compliments on them already. Highly recommend!"
      
      }

     ]
    }
   ],
   "presets": [
    {
     "name": "Testimonials"
    }
   ]
  }


  {% endschema %}
