      {% capture error_icon %}
        <svg class="pin-code-error-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
          <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
        </svg>
      {% endcapture %}
      
      <div class="pin-code-checker" style="max-width: 100%;">
      <div class="pin-code-content" style="display: flex; justify-content: flex-start; align-items: center; gap: 1rem;">
        <div class="field">
          <input
            class="field__input"
            autocomplete="off"
            type="text"
            id="pin-code-checker"
            name="pin-code-checker"
            placeholder=""
            inputmode="numeric"
            maxlength="6"
          >
          <label class="field__label" for="pin-code-checker">{{ 'Enter pin code' }}</label>
        </div>
        <button class="button pin-code-check-btn">{{ 'Check' }}</button>
       </div>
       <div class="pin-code-success-msg" style="display: none; justify-content: flex-start; align-items: center; gap: 0.5rem; margin-top: 0.3rem;">
        <span style="display: grid; place-items: center;">{{ verified_icon }}</span>
        <small class="pin-code-success-text" style="display: none;"></small>
       </div>
       <div class="pin-code-err-msg" style="display: none; justify-content: flex-start; align-items: center; gap: 0.5rem; margin-top: 0.3rem;">
        <span style="display: grid; place-items: center;">{{ error_icon }}</span>
         <small>{{ 'Enter correct pin code.' }}</small>
       </div>
       </div>


       <style>
        .pin-code-verified-icon{
            width: 18px;
            height: 18px;
            color: seagreen;
        }
        .pin-code-error-icon{
          color: #cc0000;
        }
       </style>

       <script>
        const input = document.querySelector("#pin-code-checker");
        const btn = document.querySelector(".pin-code-check-btn");
        const successMsgDiv = document.querySelector(".pin-code-success-msg");
        const successMsgText = document.querySelector(".pin-code-success-text");
        const errorMsg = document.querySelector(".pin-code-err-msg");

        input.addEventListener("input", () =>{
          input.value = input.value.replace(/\D/g, "");
          if (input.value.startsWith("0")){
           input.value = input.value.slice(1);
          }
        });


        btn.addEventListener("click", fetchPinCodes);

        function getDeliveryDate(addDays){
          const today = new Date();
          const deliveryDate = new Date(today);
          deliveryDate.setDate(today.getDate() + addDays);

          const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
          const dayIndex = deliveryDate.getDay();
          
          const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
          const monthIndex = deliveryDate.getMonth();
          
          return `Get delivery before ${days[dayIndex]}, ${deliveryDate.getDate()} ${months[monthIndex]} if ordered today.`;
        }

        async function fetchPinCodes(){
            const pin = input.value.trim();
            const pinCode = Number(pin);

            try{
                const response = await fetch(`https://api.postalpincode.in/pincode/${pinCode}`);
                const data = await response.json();
                console.log(data[0]);
                const info = data[0];
                if (info.Status === "Success"){
                    errorMsg.style.display = "none";
                    successMsgText.style.display = "block";
                    successMsgText.textContent =  getDeliveryDate(8);
                    successMsgDiv.style.display = "flex";
                }else{
                    successMsgDiv.style.display = "none";
                    successMsgText.style.display = "none";
                    errorMsg.style.display = "flex";
                }

            }
            catch(error){
                console.log("There is some bug here.", error);
            }   
    } 
  
       </script>


    